# Password the client types to open the planner
APP_PASSWORD=choose-a-strong-password
# Any long random string; changing it signs everyone out
AUTH_SECRET=replace-with-a-long-random-string

# Supabase (Project Settings > API). Server-only: never prefix the secret key with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
# Either the new secret key (sb_secret_...) or the legacy service_role key
SUPABASE_SECRET_KEY=
